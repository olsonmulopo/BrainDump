rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation helper
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Workspace Validation helper
    function isValidWorkspace(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'version']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'version', 'currentBoardId', 'boards', 'items', 'tabs', 'settings', 'timeLogs', 'trash', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() <= 256 &&
        data.version is number &&
        (!('currentBoardId' in data) || (data.currentBoardId is string && data.currentBoardId.size() <= 128)) &&
        (!('boards' in data) || data.boards is map) &&
        (!('items' in data) || data.items is map) &&
        (!('tabs' in data) || (data.tabs is list && data.tabs.size() <= 100)) &&
        (!('settings' in data) || data.settings is map) &&
        (!('timeLogs' in data) || (data.timeLogs is list && data.timeLogs.size() <= 1000)) &&
        (!('trash' in data) || data.trash is map) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User profile documents (PII isolation: only the owner can read/write)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Workspace documents
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(workspaceId) && isValidWorkspace(incoming());
      allow update: if isSignedIn() && isValidId(workspaceId) && isValidWorkspace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(workspaceId) && existing().ownerId == request.auth.uid;
    }
  }
}
